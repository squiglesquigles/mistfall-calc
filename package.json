{
  "name": "mistfall-calc",
  "version": "1.0.0",
  "description": "Mistfall Hunter Build Calculator - Find the cheapest gear combinations for your build",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "concurrently \"node backend/server.js\" \"vite\"",
    "build": "node scripts/encode-data.mjs && vite build",
